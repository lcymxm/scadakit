# ScadaKit 点表配置
#
# 每个 [tag:名称] 段描述一个位号：
#   description  中文描述（显示在 HMI 上）
#   unit         工程单位
#   station      Modbus 从站地址
#   register     寄存器地址，两种写法任选：
#                  input:0 / holding:0 / coil:0 / discrete:0   —— 表名:偏移量(从0开始)
#                  30001 / 40001 / 00001 / 10001                —— 传统五位数写法
#   type         int16 / uint16 / int32 / uint32 / float32 / bit
#                （coil 和 discrete 只能是 bit，其它寄存器不能是 bit）
#   gain         倍率，工程值 = 原始值 * gain + offset
#   offset       偏移
#   deadband     变化死区，小于此值的变化不入库
#   alarm-deadband  报警回差，默认等于 deadband
#   hihi/hi/lo/lolo  四段报警定值，不写即不报警
#
# 对应 src/plant.cpp 里模拟变电站的寄存器表。

[tag:TI-101]
description = 主变油温
unit = °C
station = 1
register = 30001
type = int16
gain = 0.1
deadband = 0.2
alarm-deadband = 1.5
hi = 58
hihi = 65
lo = 5
lolo = 0

[tag:PT-101]
description = 10kV 母线电压
unit = kV
station = 1
register = input:1
type = int16
gain = 0.1
deadband = 0.05
alarm-deadband = 0.1
hi = 10.7
lo = 10.2

